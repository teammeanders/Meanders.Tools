{
  "version": 4,
  "canonical": true,
  "references": {
    "visualLanguage": "Grasshopper-native pseudo-3D",
    "sourceExamples": [
      "Arc",
      "Attach Attributes",
      "Average",
      "Automatic Edge Surface",
      "Box 2Pt",
      "Bounding Box",
      "Deconstruct Box",
      "Deconstruct Brep",
      "Geometry Pipeline",
      "Geometry",
      "Curve"
    ],
    "visualDirection": "Use the existing Grasshopper visual language as the structural foundation, enhanced with controlled pseudo-3D depth, bevels, highlights, shadows, and compact glossy surfaces."
  },
  "canvas": {
    "grasshopper": {
      "width": 24,
      "height": 24,
      "background": "transparent"
    },
    "docs": {
      "width": 300,
      "height": 300,
      "background": "transparent"
    }
  },
  "occupancy": {
    "targetPercent": 82,
    "acceptableRangePercent": [75, 88],
    "excessiveEmptySpaceAllowed": false,
    "rule": "The semantic composition should occupy most of the canvas while preserving a controlled safe margin. Do not leave large unused areas."
  },
  "colors": {
    "accent": "#F59E0B",
    "accentHighlight": "#FBBF24",
    "accentLight": "#FEF3C7",
    "accentDark": "#D97706",
    "outline": "#15191D",
    "neutralLight": "#FFFFFF",
    "neutralMid": "#D9DDE2",
    "neutralDark": "#4B525A",
    "shadow": "#15191D"
  },
  "stroke": {
    "primaryPxAt24": 2,
    "minorPxAt24": [1, 1.5],
    "darkOutlineRequired": true,
    "pixelGridPreferred": true,
    "avoidNearHorizontalOrVerticalAngles": true,
    "outlineRule": "Use a strong dark outline to preserve the Grasshopper-native silhouette.",
    "consistencyRequired": true
  },
  "style": {
    "grasshopperNative": true,
    "rendering": "controlled-pseudo-3d",
    "pseudo3D": "visible-but-restrained",
    "flatAppIconLookAllowed": false,
    "modernWebIconLookAllowed": false,
    "glossyEffectsAllowed": true,
    "glossyEffects": "controlled",
    "bevelsAllowed": true,
    "bevels": "subtle-functional",
    "highlightsAllowed": true,
    "highlights": "small-and-controlled",
    "shadowsAllowed": true,
    "shadows": "soft-and-controlled",
    "gradientsAllowed": true,
    "gradientRule": "Use gradients only when they reinforce surface depth or beveling. Never use gradients as decoration.",
    "textAllowed": false,
    "decorativeEffectsAllowed": false,
    "strongSilhouetteRequired": true,
    "compactCompositionRequired": true,
    "primitiveCountGuideline": [2, 6],
    "depthMustSupportMeaning": true,
    "rule": "Pseudo-3D treatment is part of the visual language, but depth must support the semantic object rather than become the subject."
  },
  "visualHierarchy": {
    "rule": "Every icon must have one dominant semantic object or operation.",
    "primaryObject": {
      "required": true,
      "visualPriority": 1,
      "mustCommunicateFunction": true
    },
    "supportingObject": {
      "allowed": true,
      "maximum": 1,
      "visualPriority": 2,
      "mustSupportPrimaryFunction": true
    },
    "decorativeObject": {
      "allowed": false
    },
    "unrelatedObject": {
      "allowed": false
    },
    "overlap": {
      "allowed": true,
      "preferredWhenUseful": true,
      "rule": "Overlapping semantic objects may be used to communicate attachment, transformation, hierarchy, layering, or interaction."
    }
  },
  "semanticInterpretation": {
    "sourceOfTruth": "component-documentation-json",
    "requiredBeforeDesign": true,
    "rule": "The icon must communicate what the component does, not merely which category it belongs to.",
    "categoryIsNotMeaning": true,
    "workflow": [
      "Read the complete component documentation JSON.",
      "Identify the component's primary functional purpose.",
      "Identify the main input, operation, and output relationship.",
      "Identify the strongest visual representation of that function.",
      "Choose one dominant semantic concept.",
      "Optionally add at most one supporting concept.",
      "Use the visual hierarchy rules.",
      "Apply the Grasshopper-native pseudo-3D visual language.",
      "Reduce unnecessary geometry.",
      "Validate the result at 24x24.",
      "Only then produce the documentation version."
    ],
    "functionalCategories": [
      "geometry-creation",
      "geometry-transformation",
      "geometry-analysis",
      "data-and-attributes",
      "text-and-annotation",
      "fabrication",
      "utilities",
      "parameters"
    ],
    "priority": {
      "primaryConcept": "component-function",
      "secondaryConcept": "supporting-context",
      "category": "context-only"
    },
    "maxSupportingConcepts": 1
  },
  "semanticRules": {
    "antiGenericIconRule": true,
    "doNotUseCategoryAsPrimaryMetaphor": true,
    "doNotUseGenericManufacturingSymbolWhenFunctionIsSpecific": true,
    "primaryConceptMustComeFromDocumentation": true,
    "doNotInventUnrelatedVisualMetaphors": true,
    "doNotUseComponentNameAsVisualConcept": true,
    "doNotUseLiteralNameRepresentation": true,
    "functionOverDecoration": true,
    "examples": {
      "me-fab-text": {
        "primaryConcept": "geometric-fabrication-text",
        "secondaryConcept": "fabrication-notation",
        "avoid": [
          "generic-fabrication-symbol",
          "CNC-machine",
          "router",
          "cutter",
          "sheet-material",
          "generic-arrow",
          "generic-manufacturing-symbol"
        ],
        "guidance": "Represent the actual geometric text function using simplified glyph-like geometric strokes. Fabrication context may support the concept but must not replace the primary text-geometry concept."
      },
      "me-round-number": {
        "primaryConcept": "numeric-rounding-transformation",
        "secondaryConcept": "precision-control",
        "avoid": [
          "generic-calculator",
          "clock",
          "generic-number-badge",
          "unrelated-control-panel"
        ],
        "guidance": "Represent the transformation from a more precise numeric value to a rounded value. Use a compact semantic relationship rather than a literal calculator interface."
      }
    }
  },
  "textAndAnnotation": {
    "rule": "Text-related components should be represented through abstract geometric glyph structure rather than literal readable text.",
    "literalTextAllowed": false,
    "lettersAsReadableLabelsAllowed": false,
    "glyphStructureAllowed": true,
    "geometricStrokeLanguagePreferred": true,
    "examples": {
      "text-generation": "Use a short sequence of abstract geometric glyph strokes.",
      "text-layout": "Use repeated glyph-like geometry or alignment structure.",
      "text-analysis": "Use glyph or text-structure geometry combined with the relevant analysis concept."
    }
  },
  "fabrication": {
    "rule": "Fabrication is contextual unless fabrication itself is the primary function.",
    "genericFabricationSymbolAsPrimary": false,
    "machineMetaphorsAllowed": false,
    "toolMetaphorsAllowed": false,
    "materialMetaphorsAllowed": false,
    "fabricationNotationAllowed": true,
    "fabricationNotationIsSecondaryUnlessDocumentedOtherwise": true
  },
  "component": {
    "sharedShell": false,
    "palette": "amber-orange",
    "semanticObjectRequired": true,
    "maxSupportingConcepts": 1,
    "pseudo3DRequired": true,
    "glossyTreatmentAllowed": true,
    "bevelTreatmentAllowed": true,
    "examples": {
      "me-attribute": "attribute/tag/property symbol",
      "me-attach-attribute": "geometry + attach/link/add",
      "me-detach-geometry": "geometry + separation",
      "me-unit-converter": "measurement/ruler + two-way conversion",
      "me-fab-text": "geometric text + fabrication notation",
      "me-round-number": "numeric precision + rounding transformation"
    }
  },
  "parameter": {
    "sharedShell": true,
    "shellStyle": "dark Grasshopper-style clipped/beveled badge",
    "shellColor": "dark neutral",
    "shellRecognitionPriority": true,
    "innerGlyph": {
      "centered": true,
      "minimal": true,
      "lightNeutralPreferred": true,
      "restrainedAccent": true
    },
    "examples": {
      "me-attribute-param": "shared dark shell + attribute/tag glyph",
      "me-object-param": "shared dark shell + generic object/geometry glyph"
    }
  },
  "composition": {
    "rule": "Build the icon around a single clear semantic composition.",
    "primaryConceptCount": 1,
    "supportingConceptCountMaximum": 1,
    "decorativeConceptCount": 0,
    "preferredRelationships": [
      "transformation",
      "attachment",
      "separation",
      "containment",
      "comparison",
      "direction",
      "generation",
      "analysis",
      "conversion"
    ],
    "overlappingObjectsAllowed": true,
    "overlappingObjectsShouldBeSemantic": true,
    "visualStoryRequired": true,
    "ruleForVisualStory": "If the component transforms, attaches, separates, converts, generates, or analyzes something, prefer showing that relationship visually instead of adding unrelated symbols."
  },
  "simplification": {
    "required": true,
    "rule": "Remove every primitive that does not contribute to recognition of the primary function.",
    "maximumCompetingConcepts": 1,
    "avoid": [
      "visual clutter",
      "multiple unrelated symbols",
      "decorative badges",
      "complex UI layouts",
      "literal interfaces",
      "excessive depth",
      "excessive reflections",
      "excessive shadows",
      "duplicate geometry"
    ]
  },
  "arrows": {
    "allowed": true,
    "semanticRequired": true,
    "rule": "An arrow must communicate a real transformation, direction, flow, movement, or relationship.",
    "genericArrowAsDecoration": false,
    "duplicateArrowStrokes": false,
    "overlappingArrowStrokes": false,
    "maximumPrimaryArrows": 1,
    "style": "compact-and-integrated",
    "avoid": [
      "large-dominant-arrows",
      "decorative-arrows",
      "multiple-arrows-without-semantic-need"
    ]
  },
  "depth": {
    "enabled": true,
    "style": "controlled-pseudo-3d",
    "surfaceSeparationAllowed": true,
    "bevelAllowed": true,
    "highlightAllowed": true,
    "shadowAllowed": true,
    "softShadowPreferred": true,
    "depthHierarchy": [
      "primary-semantic-object",
      "supporting-semantic-object",
      "surface-highlight",
      "controlled-shadow"
    ],
    "rule": "Depth should clarify object hierarchy and physical form. It must never obscure the semantic relationship."
  },
  "surfaceTreatment": {
    "primarySurfaces": ["white", "light-neutral", "accent"],
    "outline": "dark",
    "bevel": "subtle",
    "highlight": "small",
    "shadow": "soft",
    "gloss": "restrained",
    "metallicLook": "allowed only when semantically useful",
    "plasticLook": "allowed only when semantically useful",
    "rule": "Surface treatment should make simple geometry feel dimensional without turning the icon into a product render."
  },
  "background": {
    "required": "transparent",
    "alphaRequired": true,
    "checkerboardAllowedInsideExport": false,
    "checkerboardIsPreviewOnly": true,
    "whiteBackgroundAllowed": false,
    "coloredBackgroundAllowed": false
  },
  "antiAppIcon": {
    "flatAppIconLookAllowed": false,
    "modernDashboardLookAllowed": false,
    "UIContainerLookAllowed": false,
    "badgeLookAllowed": false,
    "cardLookAllowed": false,
    "buttonLookAllowed": false,
    "rule": "The icon may be glossy and pseudo-3D, but it must remain a compact Grasshopper component icon rather than a UI/app icon."
  },
  "naming": {
    "basePattern": "me-<name>",
    "masterPattern": "me-<name>.svg",
    "docsPngPattern": "me-<name>-300.png",
    "grasshopperPngPattern": "me-<name>-24.png"
  },
  "exportRules": {
    "exactDimensionsRequired": true,
    "transparentPngRequired": true,
    "designFor24First": true,
    "simpleDownscaleOnly": false,
    "requiredExports": ["24x24 Grasshopper PNG", "300x300 documentation PNG"],
    "masterVectorRequired": true,
    "masterVectorFormat": "SVG"
  },
  "qualityControl": {
    "semanticClarity": "mandatory",
    "visualConsistency": "mandatory",
    "24pxReadability": "mandatory",
    "occupancyCheck": "mandatory",
    "transparencyCheck": "mandatory",
    "filenameCheck": "mandatory",
    "exportDimensionCheck": "mandatory",
    "duplicateStrokeCheck": "mandatory",
    "unnecessaryPrimitiveCheck": "mandatory",
    "appIconAestheticCheck": "mandatory"
  },
  "checklist": [
    "read-component-documentation-first",
    "read-complete-icon-system",
    "identify-primary-functional-purpose",
    "identify-input-operation-output",
    "category-is-context-not-primary-meaning",
    "choose-one-strong-semantic-concept",
    "use-at-most-one-supporting-concept",
    "do-not-use-generic-category-symbol",
    "do-not-use-unrelated-symbols",
    "use-controlled-pseudo-3d",
    "use-subtle-bevel-when-useful",
    "use-controlled-highlights",
    "use-controlled-soft-shadows",
    "do-not-create-app-icon-look",
    "do-not-create-ui-card-look",
    "no-excessive-gloss",
    "no-excessive-depth",
    "no-decorative-effects",
    "arrows-have-semantic-purpose",
    "no-duplicate-arrow-strokes",
    "strong-silhouette",
    "high-occupancy",
    "occupancy-between-75-and-88-percent",
    "controlled-safe-margin",
    "transparent-background",
    "real-alpha-transparency",
    "no-checkerboard-in-export",
    "accent-is-F59E0B",
    "dark-outline-present",
    "grasshopper-native-style",
    "24x24-first",
    "clear-at-24x24",
    "minimal-detail",
    "component-vs-param-grammar-correct",
    "correct-filename",
    "exact-300x300-export",
    "exact-24x24-export"
  ]
}
