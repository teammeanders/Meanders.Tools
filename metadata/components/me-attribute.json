{
  "$schema": "../component.schema.json",

  "id": "me-attribute",
  "guid": "C91E7F42-5A63-4D88-B2E1-06F4A9C73D15",

  "name": "ME Attribute",
  "nickname": "ME Attr",

  "category": "Meanders",
  "subcategory": "Attributes",

  "status": "development",

  "introducedIn": "0.1.0",
  "lastUpdatedIn": "0.1.0",
  "deprecatedIn": null,

  "releaseDate": null,
  "lastUpdated": "2026-09-30",

  "description": {
    "short": "Create or modify Meanders object attributes.",
    "long": "Creates a new Meanders attribute object or modifies an existing ME Attribute or Rhino ObjectAttributes instance. The component supports object name, layer assignment, object color, and Rhino user text key-value pairs."
  },

  "icon": {
    "source": null,
    "grasshopper": null,
    "website": null,
    "alt": "ME Attribute component icon"
  },

  "inputs": [
    {
      "id": "existing-attributes",
      "index": 0,
      "name": "Existing Attributes",
      "nickname": "A",
      "type": "generic",
      "acceptedTypes": [
        "ME_Attribute",
        "ME_Attribute_Goo",
        "Rhino.DocObjects.ObjectAttributes"
      ],
      "access": "item",
      "optional": true,
      "default": null,
      "description": "Existing ME Attribute or Rhino ObjectAttributes to modify."
    },
    {
      "id": "keys",
      "index": 1,
      "name": "Keys",
      "nickname": "K",
      "type": "text",
      "access": "list",
      "optional": true,
      "default": [],
      "description": "User text keys."
    },
    {
      "id": "values",
      "index": 2,
      "name": "Values",
      "nickname": "V",
      "type": "text",
      "access": "list",
      "optional": true,
      "default": [],
      "description": "User text values corresponding to the supplied keys."
    },
    {
      "id": "name",
      "index": 3,
      "name": "Name",
      "nickname": "N",
      "type": "text",
      "access": "item",
      "optional": true,
      "default": null,
      "description": "Rhino object name."
    },
    {
      "id": "layer",
      "index": 4,
      "name": "Layer",
      "nickname": "L",
      "type": "text",
      "access": "item",
      "optional": true,
      "default": null,
      "description": "Full Rhino layer path to assign to the object attributes."
    },
    {
      "id": "object-color",
      "index": 5,
      "name": "Object Color",
      "nickname": "Oc",
      "type": "color",
      "access": "item",
      "optional": true,
      "default": null,
      "description": "Object display color stored in the Rhino object attributes."
    }
  ],

  "outputs": [
    {
      "id": "attributes",
      "index": 0,
      "name": "Attributes",
      "nickname": "A",
      "type": "ME_Attribute",
      "access": "item",
      "description": "Resulting Meanders attribute object."
    },
    {
      "id": "keys",
      "index": 1,
      "name": "Keys",
      "nickname": "K",
      "type": "text",
      "access": "list",
      "description": "User text keys stored in the resulting attributes."
    },
    {
      "id": "values",
      "index": 2,
      "name": "Values",
      "nickname": "V",
      "type": "text",
      "access": "list",
      "description": "User text values stored in the resulting attributes."
    },
    {
      "id": "name",
      "index": 3,
      "name": "Name",
      "nickname": "N",
      "type": "text",
      "access": "item",
      "description": "Object name stored in the resulting attributes."
    },
    {
      "id": "layer",
      "index": 4,
      "name": "Layer",
      "nickname": "L",
      "type": "text",
      "access": "item",
      "description": "Full Rhino layer path stored in the resulting attributes."
    },
    {
      "id": "object-color",
      "index": 5,
      "name": "Object Color",
      "nickname": "Oc",
      "type": "color",
      "access": "item",
      "description": "Object color stored in the resulting attributes."
    }
  ],

  "behavior": {
    "createsNewDataWhenInputMissing": true,
    "modifiesCopyOfInput": true,
    "requiresActiveRhinoDocument": true,
    "runtimeWarnings": [],
    "runtimeErrors": [
      "Existing Attributes must be ME Attribute or Rhino ObjectAttributes.",
      "Keys and Values must have the same number of items."
    ]
  },

  "source": {
    "class": "ME_Attribute_Component",
    "namespace": "Meanders.Tools.Grasshopper.Components",
    "file": "Meanders.Tools/Grasshopper/Components/ME_Attribute_Component.cs"
  },

  "dependencies": [
    "ME_Attribute",
    "ME_Attribute_Goo",
    "Rhino.DocObjects.ObjectAttributes"
  ],

  "tags": ["attributes", "metadata", "rhino", "user-text", "layer", "color"],

  "documentation": {
    "slug": "me-attribute",
    "status": "draft",
    "examples": [],
    "relatedComponents": []
  },

  "compatibility": {
    "rhino": ["7"],
    "grasshopper": ["7"],
    "platforms": ["windows"]
  }
}
