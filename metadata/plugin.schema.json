{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meanders.tools/schemas/plugin.schema.json",
  "title": "Meanders.Tools Plugin Metadata",
  "description": "Schema for plugin-level metadata used by Meanders.Tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "displayName",
    "version",
    "status",
    "description",
    "author",
    "repository",
    "compatibility",
    "distribution",
    "documentation",
    "release",
    "assembly"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["development", "testing", "experimental", "stable", "deprecated"]
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short", "long"],
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1
        },
        "long": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rhino", "grasshopper", "platforms", "frameworks"],
      "properties": {
        "rhino": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "grasshopper": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["windows", "macos"]
          },
          "uniqueItems": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "githubReleases", "yak", "installer"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["internal", "public"]
        },
        "githubReleases": {
          "type": "boolean"
        },
        "yak": {
          "type": "boolean"
        },
        "installer": {
          "type": "boolean"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "website"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "draft", "review", "complete"]
        },
        "website": {
          "type": ["string", "null"]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "stable", "releaseDate"],
      "properties": {
        "current": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "stable": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "releaseDate": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grasshopperName", "assemblyGuid"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "grasshopperName": {
          "type": "string",
          "minLength": 1
        },
        "assemblyGuid": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        }
      }
    }
  }
}
